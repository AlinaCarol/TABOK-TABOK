using Godot;
using System;
using System.Collections.Generic;
using System.Linq;

using Landmarks_ = CrossyRoadBase.Landmarks;

namespace CrossyRoadBase;

/// <summary>
/// One Cebu city or municipality. A new one is picked at random every run: it changes the colors,
/// the traffic mix, the sidewalk props, the canal and the landmarks you pass.
/// </summary>
public class CityTheme
{
    public string Name, Kind, Tagline;              // Kind is "City" or "Municipality"
    public Color Sky, Sun, SidewalkA, SidewalkB, Road, Water;
    public float Ambient = 0.55f;

    // vehicle mix (relative weights)
    public float Jeepney, Car, Taxi, Motor, Trike, Truck;
    public float TrafficDensity = 1f;                // 1 = normal, lower = more space between vehicles

    // lane mix (relative weights)
    public float WGrass, WRoad, WConstruction, WRiver;

    // canal
    public float Litter = 1f;                        // 1 = clogged estero, 0 = clean water
    public bool Shanties = true;                     // canal banks: shanties (true) or nipa cottages and palms (false)

    // sidewalk props (relative weights)
    public float PPeople = 0.45f, PStop = 0.15f, PBin = 0.25f, PKubo = 0.15f, PPalm = 0f;

    public Func<Node3D>[] Landmarks;

    public string Welcome => Kind == "Municipality" ? $"the Municipality of {Name}" : Name;

    // ------------------------------------------------------------------

    static string lastName;
    static CityTheme current;
    public static CityTheme Current => current ??= All[0];

    public static CityTheme Pick(Random rng)
    {
        var options = All.Where(t => t.Name != lastName).ToList(); // never the same place twice in a row
        current = options[rng.Next(options.Count)];
        lastName = current.Name;
        return current;
    }

    static Color C(string hex) => new Color(hex);

    public static readonly List<CityTheme> All = new()
    {
        new CityTheme
        {
            Name = "Cebu City", Kind = "City", Tagline = "Queen City of the South",
            Sky = C("#a8dcf0"), Sun = C("#fff6e6"),
            SidewalkA = C("#c9c6bd"), SidewalkB = C("#b9b6ad"), Road = C("#4a4a52"), Water = C("#6a8794"),
            Jeepney = 0.22f, Car = 0.22f, Taxi = 0.12f, Motor = 0.22f, Trike = 0.12f, Truck = 0.10f,
            TrafficDensity = 1f,
            WGrass = 0.26f, WRoad = 0.46f, WConstruction = 0.10f, WRiver = 0.18f,
            Litter = 1f, Shanties = true,
            Landmarks = new Func<Node3D>[]
            {
                Landmarks_.Basilica, Landmarks_.Cathedral, Landmarks_.SmCityCebu, Landmarks_.AyalaCenter,
                Landmarks_.UscCampus, Landmarks_.MagellansCross, Landmarks_.FortSanPedro,
                () => Landmarks_.Market("CARBON MARKET")
            }
        },
        new CityTheme
        {
            Name = "Lapu-Lapu City", Kind = "City", Tagline = "Island of Mactan",
            Sky = C("#9fd8f2"), Sun = C("#ffe9c4"),
            SidewalkA = C("#d9cfb0"), SidewalkB = C("#cfc4a2"), Road = C("#4d4d55"), Water = C("#5aa5b5"),
            Jeepney = 0.12f, Car = 0.14f, Taxi = 0.06f, Motor = 0.28f, Trike = 0.30f, Truck = 0.10f,
            TrafficDensity = 0.9f,
            WGrass = 0.30f, WRoad = 0.44f, WConstruction = 0.08f, WRiver = 0.18f,
            Litter = 0.5f, Shanties = true,
            PPalm = 0.15f,
            Landmarks = new Func<Node3D>[]
            {
                Landmarks_.MactanShrine,
                () => Landmarks_.Mall("GAISANO GRAND MALL", C("#fafafa"), C("#1565c0")),
                () => Landmarks_.HeritageChurch("LAPU-LAPU PARISH CHURCH", C("#e8dcc0"), C("#ffffff"), C("#8d4b2f")),
                () => Landmarks_.BeachResort("MACTAN BEACH RESORT"),
                () => Landmarks_.Market("LAPU-LAPU PUBLIC MARKET")
            }
        },
        new CityTheme
        {
